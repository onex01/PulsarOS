# PulsarOS Init Configuration
# SPDX-License-Identifier: MIT
# Copies configs from vendor to app data directories on first boot

on post-fs-data
    mkdir /data/pulsaros 0750 system system
    mkdir /data/pulsaros/ssh 0700 system system

on property:sys.boot_completed=1
    chmod 0755 /vendor/bin/storage-watcher.sh
    chmod 0755 /vendor/bin/ssh-toggle.sh
    chmod 0755 /vendor/bin/set-resolution.sh
    start storage-watcher
    start pulsaros-setup
    exec u:r:su:s0 -- /system/bin/sh -c "[ \"$(getprop ro.build.type)\" = \"userdebug\" ] && /vendor/bin/ssh-toggle.sh start"

service storage-watcher /vendor/bin/sh /vendor/bin/storage-watcher.sh
    class late_start
    user root
    group root sdcard_rw
    disabled

service ssh-manager /vendor/bin/sh /vendor/bin/ssh-toggle.sh start
    class late_start
    user root
    group root
    disabled
    oneshot

# PulsarOS first-boot setup: copy configs to app data dirs
service pulsaros-setup /system/bin/sh /vendor/bin/pulsaros-firstboot.sh
    class late_start
    user root
    group root
    disabled
    oneshot

# ZRAM
on property:sys.boot_completed=1
    write /proc/sys/vm/swappiness 60

# Web file manager service
service pulsaros-webserver /system/bin/sh /vendor/bin/pulsaros-webserver.sh
    class late_start
    user root
    group root
    disabled
    oneshot
