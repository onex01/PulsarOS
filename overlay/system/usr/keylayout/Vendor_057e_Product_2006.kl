# PulsarOS — Nintendo Joy-Con (L)
# Left half of a Joy-Con pair. Has its own stick, L/ZL, minus and capture.
# Each half is a separate HID device, so both files are needed.

key 0x130    BUTTON_A
key 0x131    BUTTON_B
key 0x133    BUTTON_Y
key 0x134    BUTTON_X
key 0x136    BUTTON_L1
key 0x138    BUTTON_L2
key 0x13a    BUTTON_SELECT
key 0x13c    HOME

axis 0x00    X
axis 0x01    Y
key 0x13d    BUTTON_THUMBL

# D-pad buttons are individual keys on this half
key 0x220    DPAD_UP
key 0x221    DPAD_DOWN
key 0x222    DPAD_LEFT
key 0x223    DPAD_RIGHT

axis 0x10    HAT_X
axis 0x11    HAT_Y
