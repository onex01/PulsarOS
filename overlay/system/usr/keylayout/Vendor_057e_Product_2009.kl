# PulsarOS — Nintendo Switch Pro Controller (HAC-013), Bluetooth, 057e:2009
#
# Стоковая AOSP-раскладка для этого геймпада написана под другой порядок
# кнопок в HID-репорте и на этом ядре неверна. Проверено на устройстве
# через getevent (нажатия по одной кнопке, с метками времени):
#
#   0x130 A (правая)      0x131 B (нижняя)
#   0x132 X (верхняя)     0x133 Y (левая)     <- 0x132 в стоке вообще не описан
#   0x134 L               0x135 R
#   0x136 ZL              0x137 ZR
#   0x138 Minus           0x139 Plus
#   0x13a L3              0x13b R3
#   0x13c Home            0x13d Capture
#   D-pad: ABS_HAT0X (0x10), ABS_HAT0Y (0x11), не клавиши
#
# Коды Android ниже заданы в Xbox-позиционной схеме (A — нижняя, B — правая,
# X — левая, Y — верхняя): RetroArch в Android раскладывает keycode в RetroPad
# именно так, поэтому только при такой записи физические A/B/X/Y попадают
# на одноимённые кнопки RetroPad, а не меняются местами.

key 0x130    BUTTON_B
key 0x131    BUTTON_A
key 0x132    BUTTON_Y
key 0x133    BUTTON_X

key 0x134    BUTTON_L1
key 0x135    BUTTON_R1
key 0x136    BUTTON_L2
key 0x137    BUTTON_R2

key 0x138    BUTTON_SELECT
key 0x139    BUTTON_START

key 0x13a    BUTTON_THUMBL
key 0x13b    BUTTON_THUMBR

key 0x13c    HOME
key 0x13d    BUTTON_MODE

axis 0x00    X
axis 0x01    Y
axis 0x03    Z
axis 0x04    RZ

axis 0x10    HAT_X
axis 0x11    HAT_Y

sensor 0x00 ACCELEROMETER X
sensor 0x01 ACCELEROMETER Y
sensor 0x02 ACCELEROMETER Z
sensor 0x03 GYROSCOPE X
sensor 0x04 GYROSCOPE Y
sensor 0x05 GYROSCOPE Z