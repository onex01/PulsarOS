# PulsarOS — Nintendo Joy-Con (R)
# Right half: A/B/X/Y, R/ZR, plus, home, its own stick.

key 0x130    BUTTON_A
key 0x131    BUTTON_B
key 0x133    BUTTON_Y
key 0x134    BUTTON_X
key 0x137    BUTTON_R1
key 0x139    BUTTON_R2
key 0x13b    BUTTON_START
key 0x13c    HOME

axis 0x03    Z
axis 0x04    RZ
key 0x13e    BUTTON_THUMBR

key 0x220    DPAD_UP
key 0x221    DPAD_DOWN
key 0x222    DPAD_LEFT
key 0x223    DPAD_RIGHT

axis 0x10    HAT_X
axis 0x11    HAT_Y
