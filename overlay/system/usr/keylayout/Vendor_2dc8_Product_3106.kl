# PulsarOS — 8BitDo Pro 2 (D-Input / Android mode)
# Nintendo-style face button order: physical A is the right-hand button.
key 304      BUTTON_B
key 305      BUTTON_A
key 307      BUTTON_Y
key 308      BUTTON_X
key 310      BUTTON_L1
key 311      BUTTON_R1
key 312      BUTTON_L2
key 313      BUTTON_R2
key 314      BUTTON_SELECT
key 315      BUTTON_START
key 306      BUTTON_MODE
key 317      BUTTON_THUMBL
key 318      BUTTON_THUMBR
axis 0x00    X
axis 0x01    Y
axis 0x02    Z
axis 0x05    RZ
axis 0x10    HAT_X
axis 0x11    HAT_Y
